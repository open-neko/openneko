{
 "lists": [
  {
   "name": "memory, guides and files",
   "servers": [
    "neko_memory",
    "neko_guides",
    "neko_files"
   ],
   "tools": [
    {
     "name": "memory_search",
     "description": "Semantic search over OpenNeko's saved memories. Returns top-N memories ranked by cosine similarity to the query. Use when the loaded memories above don't seem to cover what the operator is asking about.",
     "inputSchema": {
      "type": "object",
      "properties": {
       "query": {
        "type": "string",
        "minLength": 2,
        "maxLength": 800
       },
       "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
       }
      },
      "required": [
       "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
     },
     "execution": {
      "taskSupport": "forbidden"
     }
    },
    {
     "name": "memory_save",
     "description": "Save a durable memory the operator stated explicitly. Use only when the operator says to remember/save something, corrects a recurring assumption, defines a metric/business rule, or states a stable preference. Never speculatively. Default scope=global, kind=business_rule, pinned=true.",
     "inputSchema": {
      "type": "object",
      "properties": {
       "text": {
        "type": "string",
        "minLength": 5,
        "maxLength": 2000
       },
       "kind": {
        "type": "string",
        "enum": [
         "preference",
         "business_rule",
         "metric_definition",
         "thread_note",
         "correction",
         "company_context",
         "other"
        ]
       },
       "scope": {
        "type": "string",
        "enum": [
         "global",
         "thread"
        ]
       },
       "pinned": {
        "type": "boolean"
       }
      },
      "required": [
       "text"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
     },
     "execution": {
      "taskSupport": "forbidden"
     }
    },
    {
     "name": "memory_update",
     "description": "Replace the text of a saved memory. Use when the operator corrects, extends or merges a memory that is already saved, instead of saving a second memory. Pass the memory id from the loaded list or a search result, and the whole new text.",
     "inputSchema": {
      "type": "object",
      "properties": {
       "memoryId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
       },
       "text": {
        "type": "string",
        "minLength": 5,
        "maxLength": 2000
       }
      },
      "required": [
       "memoryId",
       "text"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
     },
     "execution": {
      "taskSupport": "forbidden"
     }
    },
    {
     "name": "guides_find",
     "description": "Find the installed skill guides closest in meaning to the work described.",
     "inputSchema": {
      "type": "object",
      "properties": {
       "query": {
        "type": "string",
        "minLength": 2,
        "maxLength": 800
       },
       "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
       }
      },
      "required": [
       "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
     },
     "execution": {
      "taskSupport": "forbidden"
     }
    },
    {
     "name": "files_search",
     "description": "Keyword search over the files the user uploaded: PDF, Word, PowerPoint, Excel, CSV, Markdown and text. Returns the best files with matching passages and where they are (page, slide, sheet or section). For a spreadsheet or CSV file it also lists its SQL tables and columns.",
     "inputSchema": {
      "type": "object",
      "properties": {
       "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
       },
       "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
       }
      },
      "required": [
       "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
     },
     "execution": {
      "taskSupport": "forbidden"
     }
    },
    {
     "name": "files_read_text",
     "description": "Read the text of one of the user's files, with page, slide and sheet markers. Use the path from search. A long file comes back in parts: when truncated is true, call again with offset set to offset plus the length of the text already read.",
     "inputSchema": {
      "type": "object",
      "properties": {
       "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
       },
       "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
       },
       "maxChars": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 100000
       }
      },
      "required": [
       "path"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
     },
     "execution": {
      "taskSupport": "forbidden"
     }
    },
    {
     "name": "files_query_tables",
     "description": "Run one read-only DuckDB SELECT or WITH query over the sheet tables of the user's spreadsheet and CSV files. Use the table names that search or read_text list. Each sheet has a raw table (name ends in __raw) with every cell as text by column letter. A sheet with a header row also has a typed table with named columns. Use it for sums, counts, filters and joins across sheets.",
     "inputSchema": {
      "type": "object",
      "properties": {
       "sql": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
       }
      },
      "required": [
       "sql"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
     },
     "execution": {
      "taskSupport": "forbidden"
     }
    }
   ]
  },
  {
   "name": "read-only memory",
   "servers": [
    "neko_memory"
   ],
   "memoryReadOnly": true,
   "tools": [
    {
     "name": "memory_search",
     "description": "Semantic search over OpenNeko's saved memories. Returns top-N memories ranked by cosine similarity to the query. Use when the loaded memories above don't seem to cover what the operator is asking about.",
     "inputSchema": {
      "type": "object",
      "properties": {
       "query": {
        "type": "string",
        "minLength": 2,
        "maxLength": 800
       },
       "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
       }
      },
      "required": [
       "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
     },
     "execution": {
      "taskSupport": "forbidden"
     }
    }
   ]
  }
 ],

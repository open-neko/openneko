{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "version": {
      "$ref": "#/$defs/__schema2"
    },
    "family": {
      "$ref": "#/$defs/__schema3"
    },
    "product_path": {
      "$ref": "#/$defs/__schema1"
    },
    "dataset": {
      "$ref": "#/$defs/__schema1"
    },
    "capability_tags": {
      "$ref": "#/$defs/__schema4"
    },
    "difficulty": {
      "$ref": "#/$defs/__schema1"
    },
    "semantics": {
      "$ref": "#/$defs/__schema5"
    },
    "input": {
      "$ref": "#/$defs/__schema7"
    },
    "comparison": {
      "$ref": "#/$defs/__schema8"
    },
    "oracle": {
      "$ref": "#/$defs/__schema9"
    },
    "oracles": {
      "$ref": "#/$defs/__schema11"
    },
    "phases": {
      "$ref": "#/$defs/__schema12"
    },
    "timeout": {
      "$ref": "#/$defs/__schema13"
    },
    "allowed_side_effects": {
      "$ref": "#/$defs/__schema14"
    },
    "assertions": {
      "$ref": "#/$defs/__schema15"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "family",
    "product_path",
    "dataset",
    "capability_tags",
    "difficulty",
    "semantics",
    "input",
    "phases",
    "allowed_side_effects",
    "assertions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "openneko.eval.case/v1"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "read",
        "watcher",
        "mutation",
        "resilience",
        "contract"
      ]
    },
    "__schema4": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema5": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
    },
    "__schema7": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "pair_id": {
          "$ref": "#/$defs/__schema1"
        },
        "treatment": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "pair_id",
        "treatment"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "$ref": "#/$defs/__schema10"
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/__schema1"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema1"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema10"
      }
    },
    "__schema12": {
      "default": [
        "initial"
      ],
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema13": {
      "type": "string",
      "pattern": "^\\d+(?:ms|s|m|h)$"
    },
    "__schema14": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema15": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema16"
      }
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "dimension": {
          "type": "string",
          "enum": [
            "ground_truth",
            "method",
            "behavior",
            "safety",
            "efficiency"
          ]
        },
        "kind": {
          "$ref": "#/$defs/__schema1"
        },
        "gate": {
          "default": false,
          "type": "boolean"
        },
        "capabilities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "semantics": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "phase": {
          "$ref": "#/$defs/__schema1"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "dimension",
        "kind",
        "gate"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "product_path": {
            "const": "metric"
          }
        },
        "required": [
          "product_path"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "role": {
                "type": "string",
                "enum": [
                  "CEO",
                  "CFO",
                  "COO",
                  "CRO",
                  "CMO",
                  "CIO",
                  "CPO"
                ]
              }
            },
            "required": [
              "question",
              "role"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}

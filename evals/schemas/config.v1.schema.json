{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "openneko.eval/v1"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "adapter": {
      "$ref": "#/$defs/__schema0"
    },
    "semantics": {
      "$ref": "#/$defs/__schema1"
    },
    "pricing": {
      "$ref": "#/$defs/__schema1"
    },
    "suite": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema2"
        },
        "cases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "datasets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "defaults": {
      "default": {
        "repetitions": 1,
        "timeout": "10m",
        "execution_order": "counterbalanced",
        "concurrency": 1,
        "cache_state": "warm",
        "content_capture": "metadata",
        "max_attempts": 2
      },
      "type": "object",
      "properties": {
        "repetitions": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "timeout": {
          "default": "10m",
          "$ref": "#/$defs/__schema4"
        },
        "execution_order": {
          "default": "counterbalanced",
          "type": "string",
          "enum": [
            "declared",
            "randomized",
            "counterbalanced"
          ]
        },
        "concurrency": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cache_state": {
          "default": "warm",
          "type": "string",
          "enum": [
            "cold",
            "warm",
            "mixed"
          ]
        },
        "content_capture": {
          "default": "metadata",
          "type": "string",
          "enum": [
            "off",
            "metadata",
            "redacted"
          ]
        },
        "max_attempts": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "repetitions",
        "timeout",
        "execution_order",
        "concurrency",
        "cache_state",
        "content_capture",
        "max_attempts"
      ],
      "additionalProperties": false
    },
    "variants": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_wall_time": {
          "$ref": "#/$defs/__schema4"
        },
        "max_estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "default": {
        "check_in": "scored",
        "raw_dir": ".openneko/evals/raw",
        "state_dir": ".openneko/evals/state",
        "results_dir": "evals/results"
      },
      "type": "object",
      "properties": {
        "check_in": {
          "default": "scored",
          "type": "string",
          "enum": [
            "none",
            "scored"
          ]
        },
        "raw_dir": {
          "default": ".openneko/evals/raw",
          "type": "string",
          "minLength": 1
        },
        "state_dir": {
          "default": ".openneko/evals/state",
          "type": "string",
          "minLength": 1
        },
        "results_dir": {
          "default": "evals/results",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "check_in",
        "raw_dir",
        "state_dir",
        "results_dir"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "adapter",
    "suite",
    "datasets",
    "defaults",
    "variants",
    "artifacts"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema2"
        },
        "snapshot": {
          "$ref": "#/$defs/__schema0"
        },
        "settings": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "ref",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "pattern": "^\\d+(?:ms|s|m|h)$"
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "extends": {
          "$ref": "#/$defs/__schema0"
        },
        "backend": {
          "$ref": "#/$defs/__schema0"
        },
        "outer_model": {
          "$ref": "#/$defs/__schema6"
        },
        "data_path": {
          "type": "string",
          "enum": [
            "graphjin-direct",
            "planner-host-execute",
            "none"
          ]
        },
        "inner_model": {
          "$ref": "#/$defs/__schema6"
        },
        "settings": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "backend",
        "outer_model",
        "data_path"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "credential_ref": {
          "type": "string",
          "pattern": "^env:[A-Z][A-Z0-9_]*$"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "openneko.eval.suite/v1"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "threshold_policy": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "gates": {
      "default": {
        "require_safety": true
      },
      "type": "object",
      "properties": {
        "min_macro_ground_truth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_method": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_behavior": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_full_task_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_token_usage_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_capability_task_pass_rate": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema0"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "max_unsafe_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "require_safety": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "require_safety"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "cases",
    "gates"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema1"
        },
        "assertion_attribution": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema0"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "capabilities": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "semantics": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema3"
                }
              }
            },
            "required": [
              "capabilities"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
    }
  }
}

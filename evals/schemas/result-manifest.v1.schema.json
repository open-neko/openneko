{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openneko.eval.result-manifest/v1"
    },
    "runId": {
      "$ref": "#/$defs/__schema0"
    },
    "configId": {
      "$ref": "#/$defs/__schema0"
    },
    "suiteId": {
      "$ref": "#/$defs/__schema0"
    },
    "attestation": {
      "type": "string",
      "enum": [
        "self-reported",
        "ci-attested"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "suiteGates": {
      "default": {
        "require_safety": true
      },
      "type": "object",
      "properties": {
        "min_macro_ground_truth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_method": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_behavior": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_full_task_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_token_usage_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_capability_task_pass_rate": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema0"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "max_unsafe_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "require_safety": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "require_safety"
      ],
      "additionalProperties": false
    },
    "thresholdPolicy": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "openneko.eval.threshold-policy/v1"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "version": {
          "$ref": "#/$defs/__schema1"
        },
        "status": {
          "type": "string",
          "enum": [
            "provisional",
            "calibrated"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "introduced": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "capabilities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "group": {
                "$ref": "#/$defs/__schema0"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "display_name",
              "group",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "gates": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "history": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema17"
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "version",
        "status",
        "owner",
        "introduced",
        "last_reviewed",
        "description",
        "capabilities",
        "gates",
        "history"
      ],
      "additionalProperties": false
    },
    "thresholdPolicyDigest": {
      "type": "string",
      "pattern": "^sha256:.*"
    },
    "runtimeBudgets": {
      "type": "object",
      "properties": {
        "perEpisodeTimeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "providerOutputTokenLimit": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "modelContextTokenLimit": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "toolCallCeilings": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema0"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "harnessMaxAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "backendRetryAttempts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema0"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "concurrency": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "cacheState": {
          "type": "string",
          "enum": [
            "cold",
            "warm",
            "mixed"
          ]
        },
        "configuredModels": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema0"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "provider",
              "model"
            ],
            "additionalProperties": false
          }
        },
        "resolutionNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "required": [
        "perEpisodeTimeoutMs",
        "providerOutputTokenLimit",
        "modelContextTokenLimit",
        "toolCallCeilings",
        "harnessMaxAttempts",
        "backendRetryAttempts",
        "concurrency",
        "cacheState",
        "configuredModels",
        "resolutionNotes"
      ],
      "additionalProperties": false
    },
    "sourceRunManifestDigest": {
      "type": "string",
      "pattern": "^sha256:.*"
    },
    "rescore": {
      "type": "object",
      "properties": {
        "sourceRescoreDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "scorerId": {
          "$ref": "#/$defs/__schema0"
        },
        "scorerVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "scorerDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        }
      },
      "required": [
        "sourceRescoreDigest",
        "scorerId",
        "scorerVersion",
        "scorerDigest"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "configDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "suiteDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "datasetDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "oracleDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "scorerDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "variantDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "thresholdPolicyDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        }
      },
      "required": [
        "configDigest",
        "suiteDigest",
        "datasetDigest",
        "oracleDigest",
        "scorerDigest",
        "variantDigest",
        "sourceDigest"
      ],
      "additionalProperties": false
    },
    "datasetFingerprint": {},
    "resolvedVariants": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "effectiveConfig": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "openneko.eval/v1"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "adapter": {
          "$ref": "#/$defs/__schema0"
        },
        "semantics": {
          "$ref": "#/$defs/__schema18"
        },
        "pricing": {
          "$ref": "#/$defs/__schema18"
        },
        "suite": {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/__schema19"
            },
            "cases": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        "datasets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema20"
          }
        },
        "defaults": {
          "default": {
            "repetitions": 1,
            "timeout": "10m",
            "execution_order": "counterbalanced",
            "concurrency": 1,
            "cache_state": "warm",
            "content_capture": "metadata",
            "max_attempts": 2
          },
          "type": "object",
          "properties": {
            "repetitions": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "timeout": {
              "default": "10m",
              "$ref": "#/$defs/__schema21"
            },
            "execution_order": {
              "default": "counterbalanced",
              "type": "string",
              "enum": [
                "declared",
                "randomized",
                "counterbalanced"
              ]
            },
            "concurrency": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "cache_state": {
              "default": "warm",
              "type": "string",
              "enum": [
                "cold",
                "warm",
                "mixed"
              ]
            },
            "content_capture": {
              "default": "metadata",
              "type": "string",
              "enum": [
                "off",
                "metadata",
                "redacted"
              ]
            },
            "max_attempts": {
              "default": 2,
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "repetitions",
            "timeout",
            "execution_order",
            "concurrency",
            "cache_state",
            "content_capture",
            "max_attempts"
          ],
          "additionalProperties": false
        },
        "variants": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema22"
          }
        },
        "budgets": {
          "type": "object",
          "properties": {
            "max_wall_time": {
              "$ref": "#/$defs/__schema21"
            },
            "max_estimated_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "default": {
            "check_in": "scored",
            "raw_dir": ".openneko/evals/raw",
            "state_dir": ".openneko/evals/state",
            "results_dir": "evals/results"
          },
          "type": "object",
          "properties": {
            "check_in": {
              "default": "scored",
              "type": "string",
              "enum": [
                "none",
                "scored"
              ]
            },
            "raw_dir": {
              "default": ".openneko/evals/raw",
              "type": "string",
              "minLength": 1
            },
            "state_dir": {
              "default": ".openneko/evals/state",
              "type": "string",
              "minLength": 1
            },
            "results_dir": {
              "default": "evals/results",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "check_in",
            "raw_dir",
            "state_dir",
            "results_dir"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "id",
        "adapter",
        "suite",
        "datasets",
        "defaults",
        "variants",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "plannedSlotKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedSlotKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:.*"
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "configId",
    "suiteId",
    "attestation",
    "suiteGates",
    "sourceRunManifestDigest",
    "source",
    "compatibility",
    "resolvedVariants",
    "effectiveConfig",
    "expectedSlotKeys",
    "files"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "qualification": {
          "$ref": "#/$defs/__schema3"
        },
        "metric": {
          "$ref": "#/$defs/__schema4"
        },
        "capability": {
          "$ref": "#/$defs/__schema5"
        },
        "security_outcome": {
          "$ref": "#/$defs/__schema6"
        },
        "severity_at_least": {
          "$ref": "#/$defs/__schema7"
        },
        "operator": {
          "$ref": "#/$defs/__schema8"
        },
        "value": {
          "$ref": "#/$defs/__schema9"
        },
        "minimum_samples": {
          "$ref": "#/$defs/__schema10"
        },
        "minimum_coverage": {
          "$ref": "#/$defs/__schema11"
        },
        "enforcement": {
          "$ref": "#/$defs/__schema12"
        },
        "severity": {
          "$ref": "#/$defs/__schema13"
        },
        "owner": {
          "$ref": "#/$defs/__schema14"
        },
        "rationale": {
          "$ref": "#/$defs/__schema15"
        },
        "calibration_runs": {
          "$ref": "#/$defs/__schema16"
        }
      },
      "required": [
        "id",
        "qualification",
        "metric",
        "operator",
        "value",
        "enforcement",
        "severity",
        "owner",
        "rationale",
        "calibration_runs"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "capability",
        "reliability",
        "safety"
      ]
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "macro-ground-truth",
        "macro-method",
        "macro-behavior",
        "full-task-pass-rate",
        "episode-completion-rate",
        "token-usage-coverage",
        "capability-unconditional-pass-rate",
        "capability-conditional-pass-rate",
        "capability-coverage",
        "safety-assertion-failures",
        "security-outcome-count"
      ]
    },
    "__schema5": {
      "$ref": "#/$defs/__schema0"
    },
    "__schema6": {
      "type": "string",
      "enum": [
        "assertion_failed",
        "attempted",
        "blocked",
        "completed"
      ]
    },
    "__schema7": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "__schema8": {
      "type": "string",
      "enum": [
        "gte",
        "lte",
        "eq"
      ]
    },
    "__schema9": {
      "type": "number",
      "minimum": 0
    },
    "__schema10": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema11": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema12": {
      "type": "string",
      "enum": [
        "required",
        "advisory"
      ]
    },
    "__schema13": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "__schema14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "__schema16": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "version": {
          "$ref": "#/$defs/__schema1"
        },
        "change": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "date",
        "version",
        "change"
      ],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema19"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "__schema19": {
      "type": "string",
      "minLength": 1
    },
    "__schema20": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema19"
        },
        "snapshot": {
          "$ref": "#/$defs/__schema0"
        },
        "settings": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "ref",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "__schema21": {
      "type": "string",
      "pattern": "^\\d+(?:ms|s|m|h)$"
    },
    "__schema22": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "extends": {
          "$ref": "#/$defs/__schema0"
        },
        "backend": {
          "$ref": "#/$defs/__schema0"
        },
        "outer_model": {
          "$ref": "#/$defs/__schema23"
        },
        "data_path": {
          "type": "string",
          "enum": [
            "graphjin-direct",
            "graphjin-agent",
            "planner-host-execute",
            "none"
          ]
        },
        "inner_model": {
          "$ref": "#/$defs/__schema23"
        },
        "settings": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "backend",
        "outer_model",
        "data_path"
      ],
      "additionalProperties": false
    },
    "__schema23": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "credential_ref": {
          "type": "string",
          "pattern": "^env:[A-Z][A-Z0-9_]*$"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false
    }
  }
}

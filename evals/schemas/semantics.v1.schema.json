{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "openneko.eval.semantics/v1"
    },
    "generated_from": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "schema_version",
    "generated_from",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "declared",
            "eval",
            "non-eval"
          ]
        },
        "owners": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "id",
        "category",
        "description",
        "verification",
        "disposition",
        "owners"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openneko.eval.episode/v1"
    },
    "runId": {
      "$ref": "#/$defs/__schema0"
    },
    "slotKey": {
      "type": "string",
      "minLength": 1
    },
    "pairKey": {
      "type": "string",
      "minLength": 1
    },
    "treatment": {
      "$ref": "#/$defs/__schema0"
    },
    "caseId": {
      "$ref": "#/$defs/__schema0"
    },
    "caseContentId": {
      "type": "string",
      "pattern": "^sha256:.*"
    },
    "family": {
      "type": "string",
      "enum": [
        "read",
        "watcher",
        "mutation",
        "resilience",
        "contract"
      ]
    },
    "productPath": {
      "$ref": "#/$defs/__schema0"
    },
    "difficulty": {
      "$ref": "#/$defs/__schema0"
    },
    "capabilityTags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "semantics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assertionTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assertionId": {
            "$ref": "#/$defs/__schema0"
          },
          "dimension": {
            "$ref": "#/$defs/__schema1"
          },
          "gate": {
            "type": "boolean"
          },
          "capabilities": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "semantics": {
            "default": [],
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema2"
            }
          }
        },
        "required": [
          "assertionId",
          "dimension",
          "gate",
          "capabilities",
          "semantics"
        ],
        "additionalProperties": false
      }
    },
    "variantId": {
      "$ref": "#/$defs/__schema0"
    },
    "datasetId": {
      "$ref": "#/$defs/__schema0"
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "phase": {
      "$ref": "#/$defs/__schema0"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "environment_failure"
      ]
    },
    "output": {},
    "measurements": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "observations": {
      "default": [],
      "type": "array",
      "items": {}
    },
    "semanticEvidence": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "openneko.eval.semantic-evidence/v1"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "openneko.work.semantic-trace/v1"
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "runId": {
                "type": "string",
                "minLength": 1
              },
              "orgId": {
                "type": "string",
                "minLength": 1
              },
              "runKind": {
                "type": "string",
                "enum": [
                  "work",
                  "workflow",
                  "agent-job"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "trusted-broker",
                  "trusted-host"
                ]
              },
              "operation": {
                "$ref": "#/$defs/__schema0"
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "error"
                ]
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              },
              "requestDigest": {
                "type": "string",
                "pattern": "^sha256:.*"
              },
              "responseDigest": {
                "type": "string",
                "pattern": "^sha256:.*"
              },
              "errorType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "errorDigest": {
                "type": "string",
                "pattern": "^sha256:.*"
              },
              "evidence": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "schemaVersion",
              "sequence",
              "timestamp",
              "runId",
              "orgId",
              "runKind",
              "source",
              "operation",
              "status",
              "durationMs",
              "requestDigest",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "events"
      ],
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "openneko.eval.score/v1"
        },
        "scorerId": {
          "$ref": "#/$defs/__schema0"
        },
        "scorerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "scorerDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "vector": {
          "type": "object",
          "properties": {
            "groundTruth": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "method": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "behavior": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "safety": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "efficiency": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "groundTruth",
            "method",
            "behavior",
            "safety",
            "efficiency"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "groundTruth": {
              "type": "boolean"
            },
            "method": {
              "type": "boolean"
            },
            "behavior": {
              "type": "boolean"
            },
            "safety": {
              "type": "boolean"
            },
            "efficiency": {
              "type": "boolean"
            }
          },
          "required": [
            "groundTruth",
            "method",
            "behavior",
            "safety",
            "efficiency"
          ],
          "additionalProperties": false
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "assertionId": {
                "$ref": "#/$defs/__schema0"
              },
              "dimension": {
                "$ref": "#/$defs/__schema1"
              },
              "passed": {
                "type": "boolean"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "gate": {
                "type": "boolean"
              },
              "capabilities": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "semantics": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "diagnostic": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "required": [
              "assertionId",
              "dimension",
              "passed",
              "score",
              "gate"
            ],
            "additionalProperties": false
          }
        },
        "unsafeEffects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "#/$defs/__schema0"
              },
              "capability": {
                "$ref": "#/$defs/__schema0"
              },
              "target": {
                "$ref": "#/$defs/__schema0"
              },
              "assertionId": {
                "$ref": "#/$defs/__schema0"
              },
              "source": {
                "type": "string",
                "enum": [
                  "trusted-broker",
                  "trusted-host"
                ]
              },
              "operation": {
                "$ref": "#/$defs/__schema0"
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "capability",
              "target",
              "assertionId",
              "source",
              "operation",
              "sequence"
            ],
            "additionalProperties": false
          }
        },
        "securityOutcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "assertion_failed",
                  "attempted",
                  "blocked",
                  "completed"
                ]
              },
              "kind": {
                "$ref": "#/$defs/__schema0"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "capability": {
                "$ref": "#/$defs/__schema0"
              },
              "semantic": {
                "$ref": "#/$defs/__schema2"
              },
              "assertionId": {
                "$ref": "#/$defs/__schema0"
              },
              "actorRole": {
                "type": "string",
                "enum": [
                  "member",
                  "service"
                ]
              },
              "organizationScope": {
                "type": "string",
                "enum": [
                  "same",
                  "cross",
                  "unknown"
                ]
              },
              "targetType": {
                "$ref": "#/$defs/__schema0"
              },
              "target": {
                "$ref": "#/$defs/__schema0"
              },
              "enforcementDecision": {
                "type": "string",
                "enum": [
                  "allowed",
                  "blocked",
                  "bypassed",
                  "not-applicable"
                ]
              },
              "stateBeforeDigest": {
                "type": "string",
                "pattern": "^sha256:.*"
              },
              "stateAfterDigest": {
                "type": "string",
                "pattern": "^sha256:.*"
              },
              "source": {
                "type": "string",
                "enum": [
                  "trusted-broker",
                  "trusted-host"
                ]
              },
              "operation": {
                "$ref": "#/$defs/__schema0"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "outcome",
              "kind",
              "severity",
              "capability",
              "assertionId",
              "actorRole",
              "organizationScope",
              "targetType",
              "enforcementDecision",
              "source",
              "operation",
              "sequence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "scorerId",
        "scorerVersion",
        "scorerDigest",
        "verdict",
        "vector",
        "coverage",
        "checks"
      ],
      "additionalProperties": false
    },
    "errorType": {
      "type": "string",
      "maxLength": 128
    },
    "error": {
      "type": "string",
      "maxLength": 2048
    },
    "integrityDigest": {
      "type": "string",
      "pattern": "^sha256:.*"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "slotKey",
    "caseId",
    "caseContentId",
    "family",
    "productPath",
    "difficulty",
    "capabilityTags",
    "semantics",
    "variantId",
    "datasetId",
    "repetition",
    "phase",
    "attempt",
    "startedAt",
    "finishedAt",
    "status",
    "measurements",
    "observations",
    "integrityDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "ground_truth",
        "method",
        "behavior",
        "safety",
        "efficiency"
      ]
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
    }
  }
}

{
  "name": "@neko/evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "schemas:generate": "tsx scripts/generate-json-schemas.ts",
    "semantics:generate": "tsx scripts/generate-semantics.ts",
    "learning:generate": "tsx scripts/generate-learning-corpus.ts",
    "implicit:generate": "tsx scripts/generate-implicit-corpus.ts",
    "repo:check": "tsx scripts/check-repository.ts",
